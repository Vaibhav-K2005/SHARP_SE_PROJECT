# SHARP persistence configuration
# Copy this file to .env and fill in your MongoDB connection details.

# Required to enable MongoDB persistence. If omitted, SHARP falls back to server/data/db.json.
MONGODB_URI=

# Optional database/collection names.
MONGODB_DB=sharp_hostel_portal
MONGODB_COLLECTION=app_state

# Optional single-document state id. Keep this stable to reuse the same persisted demo state.
MONGODB_STATE_ID=sharp-demo-state

# Optional server port.
PORT=3000
